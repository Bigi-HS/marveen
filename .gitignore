# Dependencies & build
node_modules/
dist/

# Secrets & personal data
.env
.env.*
store/
workspace/
agents/
# Version-control ONLY per-agent agent-config.json (no secrets: model/team/
# displayName/securityProfile/channelProvider/claudeConfigDir). Everything else
# under agents/ (channel state, tokens, .mcp.json, credentials) stays ignored.
!agents/
agents/*/*
!agents/*/
!agents/*/agent-config.json
reports/
.claude/
!.claude/settings.json
.config/

# Database
*.db
*.db-shm
*.db-wal

# Logs
*.log
*.pid

# Test artifacts
test-results/
.playwright-mcp/
coverage/

# macOS
.DS_Store

# Generated from template (personal config)
CLAUDE.md
CLAUDE.md.bak-*

# Python bytecode cache
__pycache__/
*.pyc

# Custom MCP servers and config (user-specific)
mcp-servers/
.mcp.json
mcp-catalog.local.json

# Personal/project-specific docs (not part of the product)
# Old rebuild prompts (keep V3 which is the current one)
REBUILD_PROMPT.md
REBUILD_PROMPT_V2.md
SKOOL_*.md
alkuszokatas_dashboard.md
napindito-prompt.md
scheduled-tasks.json
claudeclaw.log

# Local backup archives from scripts/backup.sh
backups/

# Local tool binaries (installed via scripts/install-gitleaks.sh, not committed)
scripts/bin/

# also ignore a node_modules symlink FILE at repo root (not just the dir)
/node_modules

# Promoted live guard copies (derived from scripts/hooks/ by scripts/promote-guard.py).
# Source of truth stays in git; the promoted bytes are a deployment artefact.
.guard/
