{
  "model": "claude-opus-4-8[1m]",
  "statusLine": {
    "type": "command",
    "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/genesis-statusline.py\"",
    "padding": 0
  },
  "enabledPlugins": {
    "slack-channel@marveen-marketplace": false,
    "telegram@claude-plugins-official": true
  },
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Write(**/.env)",
      "Edit(**/.env)",
      "Write(**/.env.*)",
      "Edit(**/.env.*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"/home/domin/marveen/.guard/guardrail-permission-rules.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      { "hooks": [
        { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/hooks/ledger-capture.py\"", "timeout": 15 },
        { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/hooks/prompt-freshness-nudge.py\"", "timeout": 5 }
      ] }
    ],
    "PostToolUse": [
      { "matcher": "mcp__plugin.telegram.telegram__reply", "hooks": [ { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/hooks/ledger-outbound.py\"", "timeout": 15 } ] },
      { "matcher": "mcp__", "hooks": [ { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/hooks/mcp-output-pi-scan.py\"", "timeout": 8 } ] },
      { "matcher": "WebSearch|WebFetch", "hooks": [ { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/hooks/mcp-output-pi-scan.py\"", "timeout": 8 } ] }
    ],
    "SessionStart": [
      { "matcher": "startup", "hooks": [
        { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/hooks/memory-replay.py\"", "timeout": 15 },
        { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/hooks/hot-cache-sessionstart.py\"", "timeout": 5 }
      ] },
      { "matcher": "startup|resume|clear", "hooks": [
        { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/hooks/ledger-replay.py\"", "timeout": 15 },
        { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/hooks/session-start-enforce.py\"", "timeout": 5 }
      ] }
    ]
  }
}
