<?xml version="1.0" encoding="utf-8"?>
<!--
  Network security config for the NoA app (ENG-195).

  Debug builds already allow all cleartext via usesCleartextTraffic="true" in
  build.gradle.kts. This file provides a principled per-domain allowlist so that
  a future release build can re-enable cleartext only for localhost/emulator
  endpoints without opening all cleartext globally.

  Release reaches the fleet backend over HTTPS at the Tailscale MagicDNS origin
  (https://bigi.tail1a5fa5.ts.net) with a publicly-trusted certificate, so the
  release build needs NO cleartext exception -- the system trust anchors cover
  it and usesCleartextTraffic stays "false". The earlier ts.net cleartext
  allowance (ENG-195 TODO "replace once a valid cert is in place") is resolved
  and removed.

  Release builds: add networkSecurityConfig="@xml/network_security_config" to
  <application> in AndroidManifest.xml to activate this config.
-->
<network-security-config>
  <!-- System CAs trust anchor (default; explicit for clarity). Covers the HTTPS
       Tailscale MagicDNS backend origin via publicly-trusted cert. -->
  <base-config cleartextTrafficPermitted="false">
    <trust-anchors>
      <certificates src="system" />
    </trust-anchors>
  </base-config>

  <!-- Debug: allow cleartext to localhost (Tauri asset server + Genesis API proxy) -->
  <domain-config cleartextTrafficPermitted="true">
    <domain includeSubdomains="false">localhost</domain>
    <domain includeSubdomains="false">127.0.0.1</domain>
    <domain includeSubdomains="false">10.0.2.2</domain>  <!-- Android emulator host -->
  </domain-config>
</network-security-config>
