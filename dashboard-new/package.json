{
  "name": "noa-dashboard-new",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "NoA fleet dashboard (greenfield, read-only F0+F1). Reads the existing :3420 backend; never opens the DB directly.",
  "scripts": {
